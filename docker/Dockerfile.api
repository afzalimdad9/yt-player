# ===== Stage 0: Build whisper.cpp =====
FROM alpine:3.20 AS whisper-builder

RUN apk add --no-cache cmake build-base git

# Pin to a specific tag for reproducible builds
ARG WHISPER_CPP_VERSION=v1.7.4
RUN git clone --depth 1 --branch ${WHISPER_CPP_VERSION} \
    https://github.com/ggml-org/whisper.cpp.git /whisper.cpp

WORKDIR /whisper.cpp
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build -j $(nproc)

# ===== Stage 1: Dependencies =====
FROM node:22-alpine AS deps
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

# Copy root configs
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json ./

# Copy all package.json files for dependency resolution
COPY packages/shared/package.json packages/shared/
COPY packages/database/package.json packages/database/
COPY packages/storage/package.json packages/storage/
COPY packages/queue/package.json packages/queue/
COPY packages/pipeline/package.json packages/pipeline/
COPY packages/api/package.json packages/api/

# Install dependencies
RUN pnpm install --frozen-lockfile

# ===== Stage 2: Build =====
FROM node:22-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/shared/node_modules ./packages/shared/node_modules
COPY --from=deps /app/packages/database/node_modules ./packages/database/node_modules
COPY --from=deps /app/packages/storage/node_modules ./packages/storage/node_modules
COPY --from=deps /app/packages/queue/node_modules ./packages/queue/node_modules
COPY --from=deps /app/packages/pipeline/node_modules ./packages/pipeline/node_modules
COPY --from=deps /app/packages/api/node_modules ./packages/api/node_modules

# Copy source files
COPY packages/ packages/

# Generate Prisma client and build
RUN cd packages/database && npx prisma generate
RUN pnpm build

# ===== Stage 3: Production =====
FROM node:22-alpine AS production

# Install FFmpeg and Python whisper (fallback) for video processing
RUN apk add --no-cache ffmpeg python3 py3-pip
RUN pip3 install openai-whisper --no-cache-dir

# Copy pre-compiled whisper.cpp binary (preferred backend)
COPY --from=whisper-builder /whisper.cpp/build/bin/whisper-cli /usr/local/bin/whisper-cli

WORKDIR /app

# Copy built artifacts
COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/
COPY --from=builder /app/packages/database/dist ./packages/database/dist
COPY --from=builder /app/packages/database/package.json ./packages/database/
COPY --from=builder /app/packages/database/node_modules/.prisma ./packages/database/node_modules/.prisma
COPY --from=builder /app/packages/storage/dist ./packages/storage/dist
COPY --from=builder /app/packages/storage/package.json ./packages/storage/
COPY --from=builder /app/packages/queue/dist ./packages/queue/dist
COPY --from=builder /app/packages/queue/package.json ./packages/queue/
COPY --from=builder /app/packages/pipeline/dist ./packages/pipeline/dist
COPY --from=builder /app/packages/pipeline/package.json ./packages/pipeline/
COPY --from=builder /app/packages/api/dist ./packages/api/dist
COPY --from=builder /app/packages/api/package.json ./packages/api/

# Copy Prisma schema for migrations at runtime
COPY --from=builder /app/packages/database/prisma ./packages/database/prisma

# Copy root package.json for workspace resolution
COPY package.json ./

EXPOSE 4000

CMD ["node", "packages/api/dist/index.js"]
