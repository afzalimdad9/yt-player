# =====================
# Database (PostgreSQL)
# =====================
DATABASE_URL=postgresql://ytplayer:ytplayer@localhost:5432/ytplayer

# =====================
# Storage (S3/MinIO)
# =====================
STORAGE_ENDPOINT=http://localhost:9000
STORING_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_BUCKET=yt-player
STORAGE_PUBLIC_URL=http://localhost:9000/yt-player
# For production S3:
# STORAGE_ENDPOINT=https://s3.amazonaws.com
# STORAGE_ACCESS_KEY=AKIA...
# STORAGE_SECRET_KEY=...
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=yt-player-prod
# STORAGE_PUBLIC_URL=https://yt-player-prod.s3.amazonaws.com

# =====================
# Redis + BullMQ
# =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =====================
# API Server
# =====================
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# =====================
# Frontend
# =====================
VITE_API_URL=http://localhost:4000

# =====================
# Video Pipeline
# =====================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_MODEL=base
TEMP_DIR=./tmp
OUTPUT_DIR=./output

# =====================
# JWT (for optional auth)
# =====================
JWT_SECRET=change-me-to-a-random-string
