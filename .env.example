# =============================================================================
# YT Player - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables with default values listed will work out-of-the-box for local dev.
# =============================================================================


# ------------------------------------------------------------------------------
# Database - PostgreSQL
# ------------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev: postgresql://ytplayer:ytplayer@localhost:5432/ytplayer
# AWS RDS: postgresql://ytplayer_admin:PASSWORD@host:5432/ytplayer?sslmode=require
DATABASE_URL=postgresql://ytplayer:ytplayer@localhost:5432/ytplayer


# ------------------------------------------------------------------------------
# Redis - BullMQ Queue Backend
# ------------------------------------------------------------------------------

# Redis server hostname
REDIS_HOST=localhost

# Redis server port
REDIS_PORT=6379

# Redis AUTH password (omit if no password set)
REDIS_PASSWORD=


# ------------------------------------------------------------------------------
# Storage - S3-Compatible (MinIO for dev, AWS S3 for prod)
# ------------------------------------------------------------------------------

# S3/MinIO endpoint URL
# For local MinIO: http://localhost:9000
# For AWS S3: https://s3.amazonaws.com (or omit to use default AWS SDK endpoint)
STORAGE_ENDPOINT=http://localhost:9000

# S3 access key
# For local MinIO: minioadmin
# For AWS: your AWS_ACCESS_KEY_ID
STORAGE_ACCESS_KEY=minioadmin

# S3 secret key
# For local MinIO: minioadmin
# For AWS: your AWS_SECRET_ACCESS_KEY
STORAGE_SECRET_KEY=minioadmin

# S3 bucket name
# For local dev: yt-player
# For production: yt-player-prod-ACCOUNT_ID
STORAGE_BUCKET=yt-player

# AWS region (for AWS S3, not needed for MinIO)
STORAGE_REGION=us-east-1

# Public-facing storage URL (for generating asset URLs)
# Local dev: http://localhost:9000/yt-player
# Production with CloudFront: https://dxxxxx.cloudfront.net
# Production with S3 direct: https://yt-player-prod.s3.amazonaws.com
STORAGE_PUBLIC_URL=http://localhost:9000/yt-player


# ------------------------------------------------------------------------------
# API Server - Fastify
# ------------------------------------------------------------------------------

# Port the API server listens on
API_PORT=4000

# Host the API server binds to (0.0.0.0 for Docker)
API_HOST=0.0.0.0

# Allowed CORS origin for the frontend
# Local dev: http://localhost:5173
# Production: https://ytplayer.example.com
API_CORS_ORIGIN=http://localhost:5173


# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------

# Environment mode (development | production | staging)
# Controls log level, quality count in dev, Prisma logging
NODE_ENV=development

# Temporary directory for processing video files
TEMP_DIR=./tmp


# ------------------------------------------------------------------------------
# Video Processing - Downloader
# ------------------------------------------------------------------------------

# Path to yt-dlp binary (auto-detected from PATH if not set)
# YT_DLP_PATH=yt-dlp


# ------------------------------------------------------------------------------
# Video Processing - Whisper Speech-to-Text
# ------------------------------------------------------------------------------

# Whisper model for speech-to-text transcription
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, large-v3, large-v3-turbo
WHISPER_MODEL=base

# Directory where Whisper GGML models are stored
# Default: ~/.cache/whisper/models
# WHISPER_MODELS_DIR=$HOME/.cache/whisper/models

# Path to whisper.cpp binary (whisper-cli)
# Auto-detected from PATH, or falls back to Python openai-whisper
# WHISPER_CPP_PATH=/usr/local/bin/whisper-cli


# ------------------------------------------------------------------------------
# AI Audio Descriptions - Vision-Language Model (VLM)
# ------------------------------------------------------------------------------

# VLM provider for generating audio descriptions from video frames
# Options: openai | anthropic | ollama
# Set to ollama for free local inference (requires Ollama server running)
DESCRIPTION_PROVIDER=openai

# OpenAI API key (required if DESCRIPTION_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Anthropic API key (required if DESCRIPTION_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# VLM model override (defaults depend on provider)
# OpenAI default: gpt-4o
# Anthropic default: claude-sonnet-4-20250514
# Ollama default: llava
# VLM_MODEL=gpt-4o

# Maximum tokens for VLM responses
# VLM_MAX_TOKENS=1024

# Ollama server base URL (only used when DESCRIPTION_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama model name (only used when DESCRIPTION_PROVIDER=ollama)
# OLLAMA_MODEL=llava


# ------------------------------------------------------------------------------
# Frontend - Vite (prefixed with VITE_)
# ------------------------------------------------------------------------------

# API base URL for the frontend
# Local dev without proxy: http://localhost:4000
# Local dev with Vite proxy (default): (leave empty, Vite proxies /api -> :4000)
# Production: https://api.ytplayer.example.com
VITE_API_URL=http://localhost:4000


# ------------------------------------------------------------------------------
# Docker Compose Production Overrides
# ------------------------------------------------------------------------------
# These are used when deploying with docker-compose.prod.yml

# AWS credentials for S3 storage (production Docker Compose)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1

# S3 bucket name for production (Docker Compose)
# S3_BUCKET=yt-player-prod
